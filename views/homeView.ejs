<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
  <%- include('partials/header') %>

  <main id="mainContent" class="bandMain">
    <%# The band runs edge to edge; its contents stay within the page width %>
    <section class="pageBand">
      <div class="bandInner pageWidth">
        <%- include('partials/flashMessages') %>
        <%- include('partials/islandSwitch', { page: 'stats' }) %>
        <%# The island's words come from services/agencies.js %>
        <h1><%= agency.copy.statsTitle %></h1>
        <p class="bandLead"><%= agency.copy.statsLead %></p>
        <% if (lastUpdated) { %>
          <p class="bandNote">Last updated <%= lastUpdated %>. All dates and times are Hawaii time.</p>
        <% } %>
        <% if (stale) { %>
          <%- include('partials/staleNotice', { message: agency.copy.staleMessage(lastUpdated, stale.ago) }) %>
        <% } %>
        <%- include('partials/dateFilter', { filterAction: agency.paths.stats }) %>
      </div>
    </section>
    

    <div class="bandContent pageWidth">
      <% if (totals.arrests === 0) { %>
        <section class="card emptyState">
          <h2>No arrests in this date range</h2>
          <% if (span) { %>
            <p>Arrests on record run from <%= span.label %>. Try a range that overlaps those dates.</p>
          <% } else { %>
            <p><%= agency.copy.noLogsYet %></p>
          <% } %>
        </section>
      <% } else { %>
        <section class="summarySection">
          <h2 class="visuallyHidden">Summary for <%= range.label %></h2>
          <% const showTrend = trend && trend.bars.length > 1; %>
          <dl class="statRow statRowHome">
            <div class="statTile statTileHero<%= showTrend ? ' hasTrend' : '' %>">
              <dt class="statLabel">Arrests</dt>
              <dd class="statValue"><%= totals.arrests.toLocaleString('en-US') %></dd>
              <% if (showTrend) { %>
                <dd class="trendCell"><%- include('partials/trendChart', { trend }) %></dd>
              <% } %>
              <dd class="statNote"><%= range.label %> (<%= range.days %> <%= range.days === 1 ? 'day' : 'days' %>)</dd>
              <% if (showTrend) { %>
                <dd class="statNote">Busiest <%= trend.unit %>: <%= trend.busiest.label %> (<%= trend.busiest.count.toLocaleString('en-US') %> <%= trend.busiest.count === 1 ? 'arrest' : 'arrests' %>)</dd>
              <% } %>
            </div>
            <div class="statTile">
              <dt class="statLabel">Median age</dt>
              <dd class="statValue"><%= totals.medianAge ?? '—' %></dd>
              <dd class="statNote">Average <%= totals.averageAge ?? '—' %></dd>
            </div>
            <div class="statTile">
              <dt class="statLabel">Men</dt>
              <dd class="statValue"><%= totals.menShare %>%</dd>
              <dd class="statNote"><%= totals.men.toLocaleString('en-US') %> arrests</dd>
            </div>
            <div class="statTile">
              <dt class="statLabel">Women</dt>
              <dd class="statValue"><%= totals.womenShare %>%</dd>
              <dd class="statNote"><%= totals.women.toLocaleString('en-US') %> arrests</dd>
            </div>
          </dl>
          <% if (totals.flagged > 0) { %>
            <p class="dataNote"><%= totals.flagged.toLocaleString('en-US') %> <%= agency.copy.flaggedNote %></p>
          <% } %>
        </section>
      <% } %>

      <%# HPD's news and X posts don't depend on the date range, so they show even when it has no arrests %>
      <% if (news) { %>
        <%- include('partials/newsSection', { news }) %>
      <% } %>

      <% if (xPosts) { %>
        <%- include('partials/xPostsSection', { xPosts }) %>
      <% } %>

      <% if (totals.arrests > 0) { %>
        <section class="card chartCard">
          <h2>Arrests by age</h2>
          <p class="chartCaption">
            Age at the time of arrest.
            <% if (totals.unknownAge > 0) { %>
              <%= totals.unknownAge.toLocaleString('en-US') %> <%= totals.unknownAge === 1 ? "arrest with an unreadable age isn't" : "arrests with an unreadable age aren't" %> shown.
            <% } %>
          </p>
          <%- include('partials/columnChart', { rows: ageBands }) %>
          <%- include('partials/tableView', {
            caption: 'Arrests by age',
            columns: ['Age', 'Arrests'],
            rows: ageBands.map((band) => [band.label, band.count.toLocaleString('en-US')]),
          }) %>
        </section>

        <% const ethnicityWord = agency.copy.ethnicityWord; %>
        <section class="card chartCard">
          <h2>Arrests by <%= ethnicityWord %></h2>
          <p class="chartCaption"><%= agency.copy.ethnicityCaption %></p>
          <%- include('partials/barList', { rows: ethnicities }) %>
          <%- include('partials/tableView', {
            caption: `Arrests by ${ethnicityWord}`,
            columns: [ethnicityWord[0].toUpperCase() + ethnicityWord.slice(1), 'Arrests'],
            rows: ethnicities.map((row) => [row.label, row.count.toLocaleString('en-US')]),
          }) %>
        </section>

        <section class="card chartCard">
          <h2>Officers by the group they arrested most</h2>
          <p class="chartCaption">
            Each square is one of the <%= officerCount.toLocaleString('en-US') %> officers who made an arrest in this range, colored by the <%= agency.copy.officerGroupWord %> they arrested most. Officers are anonymous in this chart.
          </p>
          <%- include('partials/officerUnits') %>
          <p class="chartCaveat"><%= agency.copy.officerCaveat %></p>
          <%- include('partials/tableView', {
            caption: 'Officers by the group they arrested most',
            columns: ['Group arrested most', 'Officers'],
            rows: officerGroups.map((group) => [group.label, group.count.toLocaleString('en-US')]),
          }) %>
        </section>
      <% } %>

      <section class="aboutData">
        <h2>About this data</h2>
        <p><%= agency.copy.aboutLead %> so the numbers can be checked against the Attorney General's <a href="https://ag.hawaii.gov/cpja/rs/cih/">annual crime reports</a>.</p>
      </section>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
