<%# The date filter: one-click ranges and From/To dates, from presets, range, today, and errors.
    A page can also pass filterAction (where the form goes, "/" by default) and onLight (the
    version for the page's light background; by default the filter sits on the blue page band).
    A bad range falls back to all dates on every page that uses it. %>
<% if (errors.length > 0) { %>
  <div class="formErrors" role="alert">
    <p>That date range didn't work, so all dates are shown instead:</p>
    <ul>
      <% errors.forEach((error) => { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<form class="dateFilter<%= locals.onLight ? ' dateFilterLight' : '' %>" method="get" action="<%= locals.filterAction ?? '/' %>" aria-label="Date range">
  <ul class="presetList">
    <% presets.forEach((preset) => { %>
      <li>
        <a class="presetLink" href="<%= preset.href %>"<% if (preset.selected) { %> aria-current="true"<% } %>><%= preset.label %></a>
      </li>
    <% }) %>
  </ul>

  <div class="dateField">
    <label for="startDate">From</label>
    <input type="date" id="startDate" name="start" value="<%= range.start %>" max="<%= today %>">
  </div>

  <div class="dateField">
    <label for="endDate">To</label>
    <input type="date" id="endDate" name="end" value="<%= range.end %>" max="<%= today %>">
  </div>

  <%# On the blue page band, the button is the white version %>
  <button class="button<%= locals.onLight ? '' : ' buttonInverse' %>" type="submit">Apply</button>
</form>
