<%# The accessible twin of a chart. columns: header strings; rows: arrays of cells, first cell is the row header %>
<details class="tableView">
  <summary>Show as a table</summary>
  <table>
    <caption class="visuallyHidden"><%= caption %></caption>
    <thead>
      <tr>
        <% columns.forEach((column) => { %>
          <th scope="col"><%= column %></th>
        <% }) %>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(([rowHeader, ...cells]) => { %>
        <tr>
          <th scope="row"><%= rowHeader %></th>
          <% cells.forEach((cell) => { %>
            <td><%= cell %></td>
          <% }) %>
        </tr>
      <% }) %>
    </tbody>
  </table>
</details>
