<%
  // Add a page here as each one is built
  const navLinks = [{ href: '/', label: 'Home' }];
%>
<nav class="siteNav" aria-label="Main">
  <ul class="navList">
    <% navLinks.forEach((link) => { %>
      <li>
        <a class="navLink" href="<%= link.href %>"<% if (locals.currentPath === link.href) { %> aria-current="page"<% } %>><%= link.label %></a>
      </li>
    <% }) %>
  </ul>
</nav>
