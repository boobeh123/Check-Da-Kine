<%# One arrest. tabindex="-1" lets arrestFeed.js move focus here after loading more. The
    island's words come from agency (services/agencies.js). %>
<article class="card arrestCard" tabindex="-1">
  <header class="arrestHeader">
    <div class="arrestHeading">
      <h2 class="arrestTime"><%= card.arrestedAt %></h2>
      <% if (card.warnings.length > 0) { %>
        <span class="badge badgeFlagged">Flagged for review</span>
      <% } %>
    </div>
    <p class="arrestName<% if (!card.nameShown) { %> arrestNameMissing<% } %>"><%= card.name %></p>
    <%# Only set for logged-in users (listArrests.js) %>
    <% if (card.hometown) { %>
      <p class="arrestHometown">Hometown: <%= card.hometown %></p>
    <% } %>
    <% if (card.chips.length > 0) { %>
      <ul class="chipList">
        <% card.chips.forEach((chip) => { %>
          <li class="chip"><%= chip %></li>
        <% }) %>
      </ul>
    <% } %>
  </header>

  <ol class="offenseList">
    <% card.offenses.forEach((offense) => { %>
      <li class="offenseItem">
        <div class="offenseHeading">
          <h3 class="offenseTitle"><%= offense.name %></h3>
          <% if (offense.statute) { %>
            <span class="badge badgeStatute"><%= offense.statute %></span>
          <% } %>
          <% if (offense.released) { %>
            <span class="badge badgeReleased">Released</span>
          <% } %>
        </div>
        <dl class="offenseDetails">
          <% offense.fields.forEach(([label, value]) => { %>
            <div class="offenseField">
              <dt><%= label %></dt>
              <dd><%= value %></dd>
            </div>
          <% }) %>
        </dl>
      </li>
    <% }) %>
  </ol>

  <footer class="arrestFooter">
    <% if (card.source) { %>
      <p>From <a href="<%= card.source.url %>"><%= agency.copy.sourceName %> of <%= card.source.label %></a>.</p>
    <% } %>
    <span class="ocrNote"><%= agency.copy.readNote %></span>
    <% if (card.warnings.length > 0) { %>
      <details class="arrestWarnings">
        <summary>Details flagged for review</summary>
        <ul>
          <% card.warnings.forEach((warning) => { %>
            <li><%= warning %></li>
          <% }) %>
        </ul>
      </details>
    <% } %>
  </footer>
</article>
