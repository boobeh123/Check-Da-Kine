<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
  <%- include('partials/header') %>

  <main id="mainContent" class="pageMain pageWidth">
    <section class="arrestsIntro">
      <h1>Arrests</h1>
      <p>Every arrest from HPD's published arrest logs, newest first. An arrest is not a conviction.</p>
      <% if (!showNames) { %>
        <p class="arrestsNote">Arrestee and officer names are withheld.</p>
      <% } %>
    </section>

    <% if (errors.length > 0) { %>
      <div class="formErrors" role="alert">
        <p>That link didn't work, so the newest arrests are shown instead:</p>
        <ul>
          <% errors.forEach((error) => { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <% if (!isFirstPage) { %>
      <p><a href="/arrests">Back to the newest arrests</a></p>
    <% } %>

    <% if (cards.length === 0) { %>
      <section class="card emptyState">
        <h2>No arrests yet</h2>
        <p>No arrest logs have been imported yet.</p>
      </section>
    <% } else { %>
      <div class="arrestFeed">
        <% cards.forEach((card) => { %>
          <%- include('partials/arrestCard', { card }) %>
        <% }) %>
      </div>

      <p class="feedStatus" role="status" data-start="<%= start %>" data-end="<%= end %>" data-total="<%= total %>">
        Showing arrests <%= start.toLocaleString('en-US') %>–<%= end.toLocaleString('en-US') %> of <%= total.toLocaleString('en-US') %>.
      </p>

      <% if (nextHref) { %>
        <a class="button loadMore" href="<%= nextHref %>">Load more arrests</a>
      <% } else { %>
        <p class="feedEnd">That's every arrest on record.</p>
      <% } %>
    <% } %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
