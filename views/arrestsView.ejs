<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body>
  <%- include('partials/header') %>

  <main id="mainContent" class="bandMain">
    <section class="pageBand">
      <div class="bandInner pageWidth">
        <%- include('partials/flashMessages') %>
        <h1>Arrests</h1>
        <p class="bandLead">Every arrest from HPD's published arrest logs, newest first. An arrest is not a conviction.</p>
        <% if (!showNames) { %>
          <p class="bandNote">Arrestee and officer names are withheld.</p>
        <% } %>
      </div>
    </section>

    <div class="bandContent pageWidth">
      <form class="card arrestSearch" method="get" action="/arrests" role="search">
        <label for="arrestSearchInput">Search arrests</label>
        <div class="searchRow">
          <input type="search" id="arrestSearchInput" name="q" value="<%= search %>" maxlength="100" aria-describedby="arrestSearchHint">
          <button class="button" type="submit">Search</button>
        </div>
        <p class="searchHint" id="arrestSearchHint">Whole words in a charge, statute, location, or report number, like ASSAULT, KALAKAUA, or 708-0833.</p>

        <%# The Search button applies these too. The officer list only exists for logged-in users. %>
        <div class="filterRow<%= options.officers ? ' filterRowWide' : '' %>">
          <div class="filterField">
            <label for="chargeFilter">Charge</label>
            <select id="chargeFilter" name="charge">
              <option value="">Any charge</option>
              <% options.charges.forEach((option) => { %>
                <option value="<%= option.value %>"<%= option.value === filters.charge ? ' selected' : '' %>><%= option.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="filterField">
            <label for="sexFilter">Sex</label>
            <select id="sexFilter" name="sex">
              <option value="">Any</option>
              <option value="M"<%= filters.sex === 'M' ? ' selected' : '' %>>Male</option>
              <option value="F"<%= filters.sex === 'F' ? ' selected' : '' %>>Female</option>
            </select>
          </div>
          <% if (options.officers) { %>
            <div class="filterField">
              <label for="officerFilter">Arresting officer</label>
              <select id="officerFilter" name="officer">
                <option value="">Any officer</option>
                <% options.officers.forEach((option) => { %>
                  <option value="<%= option.value %>"<%= option.value === filters.officer ? ' selected' : '' %>><%= option.label %></option>
                <% }) %>
              </select>
            </div>
          <% } %>
        </div>
      </form>

      <% const anyFilter = activeFilters.length > 0; %>
      <% if (anyFilter) { %>
        <p class="searchSummary">
          <%= total.toLocaleString('en-US') %> <%= total === 1 ? 'arrest matches' : 'arrests match' %>: <%= activeFilters.join(' · ') %>.
          <a href="/arrests">Clear all</a>
        </p>
      <% } %>

      <% if (errors.length > 0) { %>
        <div class="formErrors" role="alert">
          <p>That didn't work, so the newest arrests are shown instead:</p>
          <ul>
            <% errors.forEach((error) => { %>
              <li><%= error %></li>
            <% }) %>
          </ul>
        </div>
      <% } %>

      <% if (!isFirstPage) { %>
        <p><a href="<%= firstPageHref %>">Back to the newest <%= anyFilter ? 'matches' : 'arrests' %></a></p>
      <% } %>

      <% if (cards.length === 0 && anyFilter) { %>
        <section class="card emptyState">
          <h2>No arrests match these filters</h2>
          <p>Every filter has to match, and search looks for whole words. Try removing a filter, fewer words, or a different spelling.</p>
        </section>
      <% } else if (cards.length === 0) { %>
        <section class="card emptyState">
          <h2>No arrests yet</h2>
          <p>No arrest logs have been imported yet.</p>
        </section>
      <% } else { %>
        <div class="arrestFeed">
          <% cards.forEach((card) => { %>
            <%- include('partials/arrestCard', { card }) %>
          <% }) %>
        </div>

        <% const endMessage = anyFilter ? "That's every matching arrest." : "That's every arrest on record."; %>
        <p class="feedStatus" role="status" data-start="<%= start %>" data-end="<%= end %>" data-total="<%= total %>" data-end-message="<%= endMessage %>">
          Showing arrests <%= start.toLocaleString('en-US') %>–<%= end.toLocaleString('en-US') %> of <%= total.toLocaleString('en-US') %>.
        </p>

        <% if (nextHref) { %>
          <a class="button loadMore" href="<%= nextHref %>">Load more arrests</a>
        <% } else { %>
          <p class="feedEnd"><%= endMessage %></p>
        <% } %>
      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
